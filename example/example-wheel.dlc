            "question": {
                "type": "text",
                "content": "Explain the difference between TCP and UDP and when you would choose one over the other.",
                "title": "TCP vs UDP",
                "color": "#1e88e5"
            },
            "answers": [
                "TCP: reliable, ordered, connection. UDP: fast, no guarantees."
            ]
