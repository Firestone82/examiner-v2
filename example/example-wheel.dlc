            "question": {
                "type": "text",
                "content": "What is normalization in databases? Describe 1NF, 2NF and 3NF.",
                "title": "DB normalization",
                "color": "#fb8c00"
            },
            "answers": [
                "1NF atomic, 2NF no partial deps, 3NF no transitive deps"
            ]
