            "question": {
                "type": "text",
                "content": "Describe in detail what the lifecycle of a process looks like in a modern operating system, from creation through termination.",
                "title": "Process lifecycle",
                "color": "#e53935"
            },
            "answers": [
                "fork/exec, ready -> running -> waiting -> terminated"
            ]
